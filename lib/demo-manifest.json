    {
      "name": "add_to_cart",
      "risk": "reversible",
      "enabled": true,
      "source": "manual",
      "description": "Add a product to the shopping cart in the chosen size and quantity. Reversible: items can be removed on the cart page. Returns the new cart item count.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "description": "Product id such as 'sn-014'"
          },
          "size": {
            "type": "string",
            "description": "UK size, must be one of the product's available sizes"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "default": 1,
            "description": "Quantity, default 1"
          }
        },
        "required": [
          "product_id",
          "size"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "untrustedContentHint": true
      },
      "recipe": [
        {
          "op": "ensurePage",
          "urlPattern": "^/product/{{input.product_id}}$",
          "path": "/product/{{input.product_id}}",
          "waitFor": {
            "css": "#product-detail, #product-not-found"
          }
        },
        {
          "op": "assert",
          "target": {
            "css": "#product-not-found"
          },
          "state": "notExists",
          "message": "Product '{{input.product_id}}' does not exist."
        },
        {
          "op": "assert",
          "target": {
            "css": "#stock-status",
            "text": "out of stock"
          },
          "state": "notExists",
          "message": "Product {{input.product_id}} is out of stock."
        },
        {
          "op": "select",
          "target": {
            "css": "#size-select"
          },
          "value": "{{input.size}}"
        },
        {
          "op": "fill",
          "target": {
            "css": "#qty"
          },
          "value": "{{input.quantity | default:1}}"
        },
        {
          "op": "click",
          "target": {
            "css": "#add-to-cart"
          }
        },
        {
          "op": "waitFor",
          "target": {
            "css": "#toast.show"
          },
          "state": "visible",
          "timeoutMs": 3000,
          "errorHint": "The add-to-cart confirmation did not appear; check get_cart before retrying."
        },
        {
          "op": "extractText",
          "target": {
            "css": "#cart-count"
          },
          "type": "number",
          "as": "count"
        },
        {
          "op": "return",
          "value": {
            "added": {
              "product_id": "{{input.product_id}}",
              "size": "{{input.size}}",
              "quantity": "{{input.quantity | default:1}}"
            },
            "cart_item_count": "{{vars.count}}"
          }
        }
      ],
      "samples": [
        {
          "product_id": "sn-014",
          "size": "9",
          "quantity": 1
        }
      ],
      "verification": {
        "status": "passed",
        "checkedAt": "2026-09-02T10:47:07.474Z",
