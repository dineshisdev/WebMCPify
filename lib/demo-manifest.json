      "enabled": true,
      "source": "manual",
      "description": "Fill the checkout form and place the order for everything in the cart. The shopper must confirm in an on-page dialog before the order is submitted. Call proceed_to_checkout first. Returns the order id.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "full_name": {
            "type": "string",
            "description": "Shopper's full name"
          },
          "email": {
            "type": "string",
            "description": "Email for the order confirmation"
          },
          "address": {
            "type": "string",
            "description": "Street address"
          },
          "city": {
            "type": "string",
            "description": "City"
          },
          "pincode": {
            "type": "string",
            "description": "6-digit Indian postal code"
          },
          "payment": {
            "type": "string",
            "enum": [
              "cod",
              "card"
            ],
            "description": "cod = cash on delivery, card = card on delivery"
          }
        },
        "required": [
          "full_name",
          "email",
          "address",
          "city",
          "pincode",
          "payment"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "untrustedContentHint": false
      },
      "recipe": [
        {
          "op": "ensurePage",
          "urlPattern": "^/checkout",
          "path": "/checkout",
          "waitFor": {
            "css": "#checkout-form"
          },
          "errorHint": "Call proceed_to_checkout first (the cart may be empty)."
        },
        {
          "op": "fill",
          "target": {
            "css": "#full-name"
          },
          "value": "{{input.full_name}}"
        },
        {
          "op": "fill",
          "target": {
            "css": "#email"
          },
          "value": "{{input.email}}"
        },
        {
          "op": "fill",
          "target": {
            "css": "#address"
          },
          "value": "{{input.address}}"
        },
        {
          "op": "fill",
          "target": {
            "css": "#city"
          },
          "value": "{{input.city}}"
        },
        {
          "op": "fill",
          "target": {
            "css": "#pincode"
          },
          "value": "{{input.pincode}}"
        },
        {
          "op": "select",
          "target": {
            "css": "#payment"
          },
          "value": "{{input.payment}}"
        },
        {
          "op": "extractText",
          "target": {
            "css": "#checkout-total"
          },
          "as": "total"
        },
        {
          "op": "confirm",
          "title": "Place this order?",
          "message": "An agent wants to place an order of {{vars.total}} for {{input.full_name}}, paying by {{input.payment}}.",
          "details": [
            "Ship to: {{input.address}}, {{input.city}} {{input.pincode}}",
            "Email: {{input.email}}"
          ]
        },
        {
          "op": "click",
          "target": {
            "css": "#place-order"
          }
        },
        {
          "op": "waitFor",
          "target": {
            "css": "#order-id"
          },
          "state": "visible",
          "timeoutMs": 6000
        },
        {
          "op": "extractText",
          "target": {
            "css": "#order-id"
          },
          "as": "orderId"
        },
        {
          "op": "return",
          "value": {
            "order_placed": true,
            "order_id": "{{vars.orderId}}",
            "total": "{{vars.total}}"
          }
        }
      ],
      "samples": [
        {
          "full_name": "Asha Rao",
          "email": "asha@example.com",
          "address": "12 MG Road",
          "city": "Bengaluru",
          "pincode": "560001",
          "payment": "cod"
        }
      ],
      "verification": {
        "status": "skipped",
        "checkedAt": "2026-09-02T10:47:07.474Z",
        "sampleInput": {
          "full_name": "Asha Rao",
          "email": "asha@example.com",
          "address": "12 MG Road",
          "city": "Bengaluru",
          "pincode": "560001",
          "payment": "cod"
        },
        "error": "sensitive tools are dry-run (confirm UI not completed in headless verify)",
        "durationMs": 20470
      }
    }
  ]
}
