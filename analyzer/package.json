{
  "name": "webmcpify-analyzer",
  "version": "0.1.0",
  "private": true,
  "description": "WebMCPify analyzer service: crawls a site with Playwright to build a CapabilityModel and verifies generated tools by running the bridge in a real browser.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "fastify": "^5.3.2",
    "playwright": "1.62.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.0"
  },
  "engines": {
    "node": ">=22"
  }
}
