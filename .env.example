# Next.js dashboard (Netlify in prod). Models are called directly on the OpenAI API.
# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
GEN_MODEL=gpt-5.6-sol
REPAIR_MODEL=gpt-5.6-terra

# Upstash Redis (leave empty to use .data/ JSON files locally)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Playwright analyzer (local: http://localhost:10000)
ANALYZER_URL=http://localhost:10000
ANALYZER_TOKEN=

# Cloudflare Worker origin that reverse-proxies sites
WORKER_ORIGIN=http://localhost:8787
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# Demo store origin (second Netlify site in prod; local serve on :8080)
DEMO_STORE_ORIGIN=http://localhost:8080

# Skip live Playwright verification (tools stay unverified)
# SKIP_VERIFY=1

# Analyzer service
# PORT=10000
# BRIDGE_URL=https://webmcpify.netlify.app/bridge.js
